diff --git a/app/test/story_deletion_test.dart b/app/test/story_deletion_test.dart
new file mode 100644
--- /dev/null
+++ b/app/test/story_deletion_test.dart
@@ -0,0 +1,60 @@
+import 'dart:async';
+import 'dart:convert';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:http/http.dart' as http;
+import 'package:http/testing.dart';
+import 'package:study_birds/core/repositories/stories_repository.dart';
+import 'package:study_birds/core/services/auth_session.dart';
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  test(
+      'pending deletion hides cached stories, deduplicates requests and restores on failure',
+      () async {
+    final previous = AuthSession.instance.currentUser,
+        oldToken = AuthSession.instance.token;
+    AuthSession.instance.currentUser = null;
+    AuthSession.instance.token = 'delete-cache-test';
+    addTearDown(() {
+      AuthSession.instance.currentUser = previous;
+      AuthSession.instance.token = oldToken;
+    });
+    final pending = Completer<http.Response>();
+    var deletes = 0;
+    final repo = StoriesRepository.instance;
+    await http.runWithClient(() async {
+      await repo.feed();
+      expect(repo.cachedFeed()!.stories.length, 1);
+      final deletion = repo.deleteStory('delete-cache-id');
+      final repeated = repo.deleteStory('delete-cache-id');
+      expect(identical(deletion, repeated), true);
+      expect(repo.cachedFeed()!.stories, isEmpty);
+      final failure = expectLater(deletion, throwsException);
+      pending.complete(http.Response('{}', 503));
+      await failure;
+      expect(deletes, 1);
+      expect(repo.isHidden('delete-cache-id'), false);
+      expect(repo.cachedFeed()!.stories.single.id, 'delete-cache-id');
+    },
+        () => MockClient((request) async {
+              if (request.method == 'DELETE') {
+                deletes++;
+                return pending.future;
+              }
+              return http.Response(
+                  jsonEncode({
+                    'stories': [
+                      {
+                        'id': 'delete-cache-id',
+                        'text': 'Test',
+                        'author': {'id': 'owner', 'name': 'Owner'},
+                        'expiresAt': DateTime.now()
+                            .add(const Duration(hours: 1))
+                            .toIso8601String()
+                      }
+                    ]
+                  }),
+                  200);
+            }));
+  });
+}
