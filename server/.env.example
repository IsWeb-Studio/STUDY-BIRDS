# انسخ الملف إلى server/.env محليًا، أو أضف القيم لخدمة السيرفر على Render.
# القيم السرية المطلوبة فارغة عمدًا؛ لا ترفع ملف .env إلى Git.

# التشغيل: استخدم development محليًا وproduction على Render لإخفاء تفاصيل الأخطاء.
NODE_ENV=development
PORT=5000
# Render يحدد PORT وRENDER تلقائيًا؛ لا تضف RENDER=true محليًا.

# مطلوب: رابط MongoDB ومفتاح JWT عشوائي طويل خاص بهذا المشروع.
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# المفتاح نفسه يؤمّن الجلسات وتوقيع رموز البريد؛ تغييره يبطل الجلسات والرموز القديمة.

# نطاق الواجهة المعتمد للروابط والسماح بطلبات المتصفح (دون /api).
CLIENT_URL=https://study-birds.onrender.com
CLIENT_URLS=https://study-birds.onrender.com,http://localhost:5173
# عند استخدام نطاق مخصص، أضفه إلى CLIENT_URLS مفصولًا بفاصلة وحدّث CLIENT_URL.

# اختياري: Google Web Client ID المطابق للواجهة. يمكن فصل عدة معرفات بفاصلة.
GOOGLE_CLIENT_ID=

# ─── البريد الإلكتروني — مطلوب لرموز OTP وتأكيد البريد واستعادة كلمة المرور ───
# الأولوية: إذا ضبطت BREVO_API_KEY يُستخدم Brevo REST API مباشرةً (أفضل).
# إذا تركت BREVO_API_KEY فارغًا يُستخدم SMTP كاحتياط.

# Brevo REST API (الطريقة الموصى بها):
# المفتاح: Brevo Dashboard → SMTP & API → API Keys → أنشئ مفتاحًا جديدًا (v3)
BREVO_API_KEY=
# بريد المرسل الموثّق في Brevo: Senders → Add a new sender
BREVO_SENDER_EMAIL=
# اسم المرسل الذي يظهر في البريد (اختياري، الافتراضي: Study Birds)
BREVO_SENDER_NAME=Study Birds

# SMTP احتياط (اتركه فارغًا إن كنت تستخدم Brevo API):
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# SMTP_USER: اسم دخول SMTP من Brevo Dashboard → SMTP & API → SMTP
# (هو بريد حساب Brevo، وليس BREVO_API_KEY)
SMTP_USER=
# SMTP_PASS: مفتاح SMTP من نفس الصفحة (يبدأ بـ xsmtp... وليس مفتاح API)
SMTP_PASS=
SMTP_FROM=

# اختياري: لاستقبال رسائل نموذج التواصل
CONTACT_FORM_TO=

# الملفات: أضف بيانات Cloudinary لتفعيل التخزين الخارجي.
UPLOAD_DIR=src/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# إعدادات اختيارية لقاعدة البيانات؛ هذه هي القيم الافتراضية في الكود.
MONGODB_RETRY_DELAY_MS=5000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# SEO في السيرفر: اترك SITE_URL فارغًا لاستخدام CLIENT_URL.
SITE_NAME=Study Birds
SITE_URL=
# NEXT_PUBLIC_SITE_URL اسم بديل قديم يقرأه مولّد SEO؛ لا يلزم إضافته.

# اختياري: رابط Deploy Hook السري للواجهة، لإجراء النشر من لوحة الإدارة.
FRONTEND_DEPLOY_HOOK_URL=

# 2FA والجلسات لا تحتاج مفاتيح منفصلة غير JWT_SECRET وإعدادات SMTP أعلاه.
# Push لم يُنفذ بعد؛ إضافة مفاتيح Firebase وحدها لا تفعّله.
# إعدادات المساعد الذكي موجودة أدناه، وتحتاج مزوّداً متوافقاً واختباراً قبل النشر.
# RENDER_API_KEY مفتاح لإدارة النشر فقط، ولا يحتاجه تشغيل الموقع أو السيرفر.

# --- Additional identity providers ---
# Apple Services ID for the website; register its HTTPS return URL with Apple.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
# Passkeys: exact domain without scheme/port, e.g. studybirds.net.
# Origins are exact HTTPS origins, comma-separated. Use localhost only for local tests.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=
# Twilio WhatsApp OTP: Account SID, Auth Token, and the WhatsApp-enabled sender number.
# Keep all three on the server only. Phone numbers use E.164 (+countrycode...).
# TWILIO_WHATSAPP_FROM: the Twilio WhatsApp number (e.g. +14155238886 for sandbox).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Bird AI: server-only Chat Completions compatible provider. No model is assumed.
# Example base URL: https://api.openai.com/v1/
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_DAILY_LIMIT=20

# Internal reminders for overdue assigned application follow-ups (no email/SMS/Push).
FOLLOW_UP_REMINDERS_ENABLED=false
# Minimum 60000; default five minutes. Requires a continuously running service.
FOLLOW_UP_REMINDERS_INTERVAL_MS=300000

# Optional public HTTPS origin serving /email-assets (default: Study Birds API).
# EMAIL_ASSET_ORIGIN=https://study-birds1.onrender.com

# Optional shared CRM workspace for linked staff; all values are server-only.
CRM_API_URL=https://your-crm-api.example/api
CRM_WEB_URL=https://your-crm.example
CRM_COMPANY_ID=company-default
STUDY_BIRDS_SSO_SECRET=
# Private CRM extension sync remains disabled until verified backups and domain adapters are ready.
CRM_TWO_WAY_SYNC_ENABLED=false
CRM_SYNC_COMPANY_ID=company-default
SYNC_BACKUP_RECEIPT_FILE=
